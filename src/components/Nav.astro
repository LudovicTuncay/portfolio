---
import { navItems } from "../data/home";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  currentPath?: string;
};

const { currentPath = "/" } = Astro.props;
const mobileMenuId = "site-mobile-nav";
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-divider)] bg-[rgb(255_255_255_/_0.88)] backdrop-blur-md"
  data-site-nav
>
  <div class="page-container">
    <div class="flex items-center justify-between py-3 md:hidden">
      <a href="/" aria-label="LKT home" class="shrink-0">
        <img src="/lkt-logo.svg" alt="LKT" class="h-auto w-8" />
      </a>

      <button
        type="button"
        class="button-shell button-primary button-icon"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls={mobileMenuId}
        aria-label="Open navigation menu"
      >
        <svg
          data-mobile-menu-icon
          aria-hidden="true"
          class="h-[24px] w-[24px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>

      </button>
    </div>

    <div
      id={mobileMenuId}
      class="hidden border-t border-[var(--color-divider)] md:hidden"
      data-mobile-menu-panel
      hidden
    >
      <nav aria-label="Primary" class="flex min-h-[calc(100dvh-73px)] flex-col py-6">
        <ul role="list" class="flex flex-col items-start gap-1">
          {navItems.map((item) => {
            const active = currentPath === item.href;
            return (
              <li class="w-full">
                <a
                  href={item.href}
                  class:list={[
                    "body-copy block py-3 text-[clamp(1.375rem,5vw,1.75rem)] transition-colors duration-100 ease-in-out",
                    active
                      ? "!font-[800] !italic !text-[var(--color-ink)] accent-glow"
                      : "hover:text-[var(--color-ink)]"
                  ]}
                  data-mobile-nav-link
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="mt-auto pt-8">
          <ThemeToggle showLabel={true} />
        </div>
      </nav>
    </div>

    <div class="hidden items-center gap-8 py-4 md:grid md:grid-cols-[32px_1fr_auto]">
      <a href="/" aria-label="LKT home" class="justify-self-start">
        <img src="/lkt-logo.svg" alt="LKT" class="h-auto w-8" />
      </a>

      <nav aria-label="Primary" class="justify-self-start md:justify-self-center">
        <ul role="list" class="flex items-center gap-x-8">
          {navItems.map((item) => {
            const active = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "body-copy transition-colors duration-100 ease-in-out",
                    active
                      ? "!font-[800] !italic !text-[var(--color-ink)] underline accent-glow"
                      : "hover:text-[var(--color-ink)]"
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="justify-self-end">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  const navRoot = document.querySelector("[data-site-nav]");

  if (navRoot) {
    const mobileToggle = navRoot.querySelector("[data-mobile-menu-toggle]");
    const mobilePanel = navRoot.querySelector("[data-mobile-menu-panel]");
    const mobileLinks = Array.from(navRoot.querySelectorAll("[data-mobile-nav-link]"));
    const desktopBreakpoint = window.matchMedia("(min-width: 768px)");

    const setMenuOpen = (open) => {
      if (!(mobileToggle instanceof HTMLButtonElement) || !(mobilePanel instanceof HTMLElement)) {
        return;
      }

      mobilePanel.hidden = !open;
      mobilePanel.classList.toggle("hidden", !open);
      mobileToggle.setAttribute("aria-expanded", String(open));
      mobileToggle.setAttribute("aria-label", open ? "Collapse navigation menu" : "Open navigation menu");
      document.body.classList.toggle("overflow-hidden", open);
    };

    setMenuOpen(false);

    mobileToggle?.addEventListener("click", () => {
      const isOpen = mobileToggle.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    desktopBreakpoint.addEventListener("change", (event) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>
