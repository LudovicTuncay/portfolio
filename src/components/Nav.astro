---
import { navItems } from "../data/home";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  currentPath?: string;
};

const { currentPath = "/" } = Astro.props;
const mobileMenuId = "site-mobile-nav";
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-divider)] bg-[var(--color-nav-surface)] backdrop-blur-md"
  data-site-nav
>
  <div class="page-container">
    <div class="flex items-center justify-between py-3 md:hidden">
      <a href="/" aria-label="LKT home" class="shrink-0">
        <img src="/lkt-logo.svg" alt="LKT" class="site-logo h-auto w-8" />
      </a>

      <button
        type="button"
        class="button-shell button-primary button-icon"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls={mobileMenuId}
        aria-label="Open navigation menu"
      >
        <span data-mobile-menu-icon="menu" aria-hidden="true">
          <svg
            class="h-[24px] w-[24px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
        </span>
        <span data-mobile-menu-icon="close" aria-hidden="true" class="hidden">
          <svg
            class="h-[24px] w-[24px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12" />
            <path d="M18 6L6 18" />
          </svg>
        </span>

      </button>
    </div>

    <div
      id={mobileMenuId}
      class="relative left-1/2 hidden w-screen -translate-x-1/2 border-t border-[var(--color-divider)] md:hidden"
      data-mobile-menu-panel
      hidden
    >
      <nav
        aria-label="Primary"
        class="mx-auto grid min-h-[calc(100dvh-73px)] w-full max-w-[var(--container-max)] grid-rows-[1fr_auto_1fr] px-6 py-6"
      >
        <ul role="list" class="row-start-2 flex flex-col items-center gap-2 text-center">
          {navItems.map((item) => {
            const active = currentPath === item.href;
            return (
              <li class="w-full">
                <a
                  href={item.href}
                  class:list={[
                    "body-copy block py-3 text-[clamp(1.5rem,7vw,2rem)] transition-colors duration-100 ease-in-out",
                    active
                      ? "!font-[800] !italic !text-[var(--color-ink)] nav-accent-glow"
                      : "hover:text-[var(--color-ink)]"
                  ]}
                  data-mobile-nav-link
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="row-start-3 self-end justify-self-center pt-8">
          <ThemeToggle showLabel={true} />
        </div>
      </nav>
    </div>

    <div class="hidden items-center gap-8 py-4 md:grid md:grid-cols-[32px_1fr_auto]">
      <a href="/" aria-label="LKT home" class="justify-self-start">
        <img src="/lkt-logo.svg" alt="LKT" class="site-logo h-auto w-8" />
      </a>

      <nav aria-label="Primary" class="justify-self-start md:justify-self-center">
        <ul role="list" class="flex items-center gap-x-8">
          {navItems.map((item) => {
            const active = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "body-copy transition-colors duration-100 ease-in-out",
                    active
                      ? "!font-[800] !italic !text-[var(--color-ink)] underline nav-accent-glow"
                      : "hover:text-[var(--color-ink)]"
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="justify-self-end">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  const navRoot = document.querySelector("[data-site-nav]");

  if (navRoot) {
    const mobileToggle = navRoot.querySelector("[data-mobile-menu-toggle]");
    const mobilePanel = navRoot.querySelector("[data-mobile-menu-panel]");
    const mobileLinks = Array.from(navRoot.querySelectorAll("[data-mobile-nav-link]"));
    const menuIcon = navRoot.querySelector('[data-mobile-menu-icon="menu"]');
    const closeIcon = navRoot.querySelector('[data-mobile-menu-icon="close"]');
    const desktopBreakpoint = window.matchMedia("(min-width: 768px)");

    const setMenuOpen = (open) => {
      if (!(mobileToggle instanceof HTMLButtonElement) || !(mobilePanel instanceof HTMLElement)) {
        return;
      }

      mobilePanel.hidden = !open;
      mobilePanel.classList.toggle("hidden", !open);
      mobileToggle.setAttribute("aria-expanded", String(open));
      mobileToggle.setAttribute("aria-label", open ? "Collapse navigation menu" : "Open navigation menu");
      menuIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
    };

    setMenuOpen(false);

    mobileToggle?.addEventListener("click", () => {
      const isOpen = mobileToggle.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    desktopBreakpoint.addEventListener("change", (event) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>
