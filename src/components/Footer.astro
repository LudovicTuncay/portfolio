---
const footerNavItems = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About Me" },
  { href: "/#resume", label: "Resume" },
  { href: "/research-code", label: "Research & code" },
  { href: "/photography", label: "Photography" }
];

const externalLinks = [
  { href: "mailto:ludovic@example.com", label: "Contact (mail)" },
  { href: "https://github.com/LudovicTuncay", label: "Github" },
  { href: "https://hal.science", label: "HAL" },
  { href: "https://scholar.google.com", label: "Google Scholar" },
  { href: "https://linkedin.com", label: "LinkedIn" },
  { href: "https://instagram.com", label: "Instagram" }
];
---

<footer class="page-container mt-10 pb-14 pt-12 md:mt-12 md:pb-20">
  <div class="divider-line pt-6">
    <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
      <div class="flex h-full flex-col justify-between gap-8">
        <div class="space-y-4">
          <a href="/" aria-label="LKT home" class="inline-block">
            <img src="/lkt-logo.svg" alt="LKT" class="site-logo h-auto w-8" />
          </a>
          <p class="body-copy max-w-[30rem]">
            PhD student in Artificial Intelligence with a taste for photography.
          </p>
        </div>
        <p class="footer-copyright pt-6 md:pt-10">&copy; 2026 Ludovic K. TUNCAY</p>
      </div>

      <div class="flex flex-col gap-[0.875rem] md:gap-[1.125rem]">
        <p class="entry-title">Navigation</p>
        <ul role="list" class="space-y-2">
          {footerNavItems.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-[0.875rem] md:gap-[1.125rem]">
        <p class="entry-title">External links</p>
        <ul role="list" class="space-y-2">
          {externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer-link"
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
