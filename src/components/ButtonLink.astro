---
type Props = {
  href: string;
  label: string;
  muted?: boolean;
  icon?: boolean;
  external?: boolean;
};

const { href, label, muted = false, icon = false, external = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "button-shell",
    muted ? "button-muted" : "button-primary",
    icon && "button-icon"
  ]}
  aria-label={icon ? label : undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  {icon ? (
    <svg
      aria-hidden="true"
      class="h-[24px] w-[24px]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 7h10v10" />
      <path d="M7 17 17 7" />
    </svg>
  ) : (
    <span>{label}</span>
  )}
</a>
