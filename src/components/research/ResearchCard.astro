---
import type { ResearchGridItem } from "../../data/research-grid";
import type { PaperStatus, ResearchPreview } from "../../data/research";
import {
  getResearchDetailHref,
  paperStatusLabels,
  researchCollectionLabels
} from "../../data/research";
import ResearchPreviewCard from "./ResearchPreview.astro";

type BaseProps = {
  slug: string;
  title: string;
  preview?: ResearchPreview;
  layout: ResearchGridItem;
};

type PaperProps = BaseProps & {
  collection: "papers";
  summary: string;
  tags: string[];
  authors: string[];
  venue: string;
  year: number;
  status: PaperStatus;
};

type RepoProps = BaseProps & {
  collection: "repos";
  description: string;
  topics: string[];
  stack: string[];
  language: string;
};

type Props = PaperProps | RepoProps;

const SELF_AUTHOR = "Ludovic K. Tuncay";

const props = Astro.props as Props;
const href = getResearchDetailHref(props.collection, props.slug);
const typeLabel = researchCollectionLabels[props.collection];

const accentVar =
  props.collection === "papers" ? "var(--color-accent)" : "var(--color-accent-secondary)";
const layoutStyle = `--desktop-span:${props.layout.desktop.span};--tablet-span:${props.layout.tablet.span};--item-order:${props.layout.order};--card-accent:${accentVar};`;

const isFeature = props.layout.variant === "feature";
const hasPreview = Boolean(props.preview) && props.layout.variant !== "compact";

const sizeClass = isFeature
  ? "min-h-[26rem]"
  : props.layout.variant === "wide"
    ? "min-h-[18rem]"
    : "min-h-[15rem]";

const titleClass = isFeature
  ? "text-[clamp(1.7rem,2.4vw,2.5rem)]"
  : props.layout.variant === "wide"
    ? "text-[clamp(1.35rem,1.7vw,1.75rem)]"
    : "text-[clamp(1.2rem,1.4vw,1.5rem)]";

const authorsWithSelf =
  props.collection === "papers"
    ? props.authors.map((author) => ({ name: author, isSelf: author === SELF_AUTHOR }))
    : null;
---

<a
  href={href}
  style={layoutStyle}
  class:list={[
    "group relative flex h-full flex-col gap-5 border border-dashed border-[var(--color-ink)] bg-[var(--color-surface)] p-5 transition-transform duration-100 ease-in-out hover:-translate-y-1 hover:shadow-[var(--shadow-button-muted)] focus-visible:-translate-y-1 focus-visible:shadow-[var(--shadow-button-muted)] md:p-6",
    sizeClass,
    "[grid-column:span_1_/_span_1] [order:var(--item-order)] md:[grid-column:span_var(--tablet-span)_/_span_var(--tablet-span)] xl:[grid-column:span_var(--desktop-span)_/_span_var(--desktop-span)]"
  ]}
>
  <header class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class="ui-copy inline-flex items-center whitespace-nowrap border border-[var(--color-ink)] px-2 py-[0.42rem] lowercase leading-none text-[var(--color-ink)]"
      >
        {typeLabel}
      </span>
      {
        props.collection === "papers" ? (
          <span class="ui-copy lowercase text-[var(--color-ink-muted)]">
            {props.venue} {props.year}
            <span class="mx-2 text-[var(--color-divider)]" aria-hidden="true">
              /
            </span>
            <span class="text-[var(--color-ink)]">{paperStatusLabels[props.status]}</span>
          </span>
        ) : (
          <span class="ui-copy lowercase text-[var(--color-ink-muted)]">
            <span class="text-[var(--color-ink)]">{props.language}</span>
          </span>
        )
      }
    </div>

    <svg
      aria-hidden="true"
      class="mt-0.5 h-5 w-5 shrink-0 text-[var(--color-ink)] transition-transform duration-100 ease-in-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 7h10v10" />
      <path d="M7 17 17 7" />
    </svg>
  </header>

  <div
    class:list={[
      "flex flex-1 gap-5",
      isFeature ? "flex-col md:flex-row md:items-stretch" : "flex-col"
    ]}
  >
    {
      hasPreview && (
        <div
          class:list={[
            "flex shrink-0",
            isFeature ? "md:order-2 md:basis-[42%]" : ""
          ]}
        >
          <ResearchPreviewCard preview={props.preview!} variant={props.layout.variant} />
        </div>
      )
    }

    <div
      class:list={[
        "flex flex-1 flex-col justify-between gap-5",
        isFeature ? "md:order-1" : ""
      ]}
    >
      <div class="space-y-3">
        <h2
          class:list={[
            "font-[var(--font-body)] font-[800] leading-[1.05] tracking-[-0.03em] text-[var(--color-ink)]",
            titleClass,
            props.collection === "repos" ? "font-[var(--font-ui)] tracking-[-0.02em]" : ""
          ]}
        >
          {props.title}
        </h2>

        {
          props.collection === "papers" ? (
            <p class="body-copy max-w-[44rem]">{props.summary}</p>
          ) : (
            <p class="body-copy max-w-[44rem]">{props.description}</p>
          )
        }
      </div>

      <div class="space-y-3 border-t border-dashed border-[var(--color-divider)] pt-4">
        {
          props.collection === "papers" ? (
            <>
              <p class="meta-copy">
                <span class="not-italic text-[var(--color-ink-muted)]">by </span>
                {authorsWithSelf!.map((author, index) => (
                  <span>{author.isSelf ? <strong class="font-[var(--font-body)] font-[800] not-italic text-[var(--color-ink)]">{author.name}</strong> : author.name}{index < authorsWithSelf!.length - 1 ? ", " : ""}</span>
                ))}
              </p>
              {props.tags.length > 0 && (
                <ul role="list" class="tag-list">
                  {props.tags.map((tag) => (
                    <li class="tag-chip tag-chip-muted">#{tag}</li>
                  ))}
                </ul>
              )}
            </>
          ) : (
            <div class="tag-list">
              {props.stack.map((tag) => (
                <span class="tag-chip tag-chip-strong">{tag}</span>
              ))}
              {props.topics.map((tag) => (
                <span class="tag-chip tag-chip-muted">#{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</a>
