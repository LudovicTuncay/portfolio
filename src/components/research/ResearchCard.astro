---
import type { ResearchGridItem } from "../../data/research-grid";
import type { PaperStatus, ResearchPreview } from "../../data/research";
import {
  getResearchDetailHref,
  paperStatusLabels,
  researchCollectionLabels
} from "../../data/research";
import ResearchPreviewCard from "./ResearchPreview.astro";
import ResearchTagList from "./ResearchTagList.astro";

type BaseProps = {
  slug: string;
  title: string;
  preview?: ResearchPreview;
  layout: ResearchGridItem;
};

type PaperProps = BaseProps & {
  collection: "papers";
  summary: string;
  tags: string[];
  authors: string[];
  venue: string;
  year: number;
  status: PaperStatus;
};

type RepoProps = BaseProps & {
  collection: "repos";
  description: string;
  topics: string[];
  stack: string[];
};

type Props = PaperProps | RepoProps;

const props = Astro.props as Props;
const href = getResearchDetailHref(props.collection, props.slug);
const metaLabel = researchCollectionLabels[props.collection];
const hasPreview = Boolean(props.preview) && props.layout.variant !== "compact";
const layoutStyle = `--desktop-span:${props.layout.desktop.span};--tablet-span:${props.layout.tablet.span};--item-order:${props.layout.order};`;

const sizeClass =
  props.layout.variant === "feature"
    ? "min-h-[32rem]"
    : props.layout.variant === "wide"
      ? "min-h-[18rem]"
      : "min-h-[16rem]";

const titleClass =
  props.layout.variant === "feature"
    ? "text-[clamp(1.9rem,2.7vw,3rem)]"
    : props.layout.variant === "wide"
      ? "text-[clamp(1.55rem,2vw,2.2rem)]"
      : "text-[clamp(1.3rem,1.55vw,1.75rem)]";
---

<a
  href={href}
  style={layoutStyle}
  class:list={[
    "group relative flex h-full flex-col justify-between gap-5 border-2 border-dashed border-[var(--color-ink)] bg-[color-mix(in_srgb,var(--color-surface)_96%,var(--color-accent)_4%)] p-5 transition-transform duration-100 ease-in-out hover:-translate-y-1 hover:shadow-[-8px_8px_0_0_rgba(253,199,0,0.18)] focus-visible:-translate-y-1 focus-visible:shadow-[-8px_8px_0_0_rgba(253,199,0,0.18)] md:p-6",
    sizeClass,
    "[grid-column:span_1_/_span_1] [order:var(--item-order)] md:[grid-column:span_var(--tablet-span)_/_span_var(--tablet-span)] xl:[grid-column:span_var(--desktop-span)_/_span_var(--desktop-span)]"
  ]}
>
  <div class="space-y-5">
    <div class="flex items-start justify-between gap-3">
      <div class="ui-copy flex min-w-0 items-center gap-3 lowercase text-[var(--color-ink-muted)]">
        <span
          class:list={[
            "inline-block h-2.5 w-2.5 shrink-0 rounded-full",
            props.collection === "papers" ? "bg-[var(--color-accent)]" : "bg-[var(--color-ink)]"
          ]}
        ></span>
        <span class="truncate">{metaLabel}</span>

        {props.collection === "papers" ? (
          <>
            <span aria-hidden="true">•</span>
            <span class="truncate">{props.venue} {props.year}</span>
            <span aria-hidden="true">•</span>
            <span class="truncate">{paperStatusLabels[props.status]}</span>
          </>
        ) : (
          <>
            <span aria-hidden="true">•</span>
            <span class="truncate">{props.slug}</span>
          </>
        )}
      </div>

      <svg
        aria-hidden="true"
        class="mt-0.5 h-5 w-5 shrink-0 text-[var(--color-ink)] transition-transform duration-100 ease-in-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 7h10v10" />
        <path d="M7 17 17 7" />
      </svg>
    </div>

    {hasPreview && <ResearchPreviewCard preview={props.preview!} variant={props.layout.variant} />}

    <div class="space-y-4">
      <h2
        class:list={[
          "font-[var(--font-body)] font-[800] leading-[1.05] tracking-[-0.03em] text-[var(--color-ink)]",
          titleClass
        ]}
      >
        {props.title}
      </h2>

      {
        props.collection === "papers" ? (
          <>
            <p class="body-copy max-w-[42rem]">{props.summary}</p>
            <p class="meta-copy">{props.authors.join(", ")}</p>
          </>
        ) : (
          <p class="body-copy max-w-[36rem]">{props.description}</p>
        )
      }
    </div>
  </div>

  <div class="space-y-3">
    {
      props.collection === "repos" && props.stack.length > 0 && (
        <ResearchTagList tags={props.stack} tone="primary" />
      )
    }

    <ResearchTagList tags={props.collection === "papers" ? props.tags : props.topics} />
  </div>
</a>
