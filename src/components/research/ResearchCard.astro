---
import type { ResearchGridItem } from "../../data/research-grid";
import type { PaperStatus, ResearchPreview } from "../../data/research";
import { FileText } from "@lucide/astro";
import { getResearchDetailHref, paperStatusLabels } from "../../data/research";
import ResearchPreviewCard from "./ResearchPreview.astro";

type BaseProps = {
    slug: string;
    title: string;
    preview?: ResearchPreview;
    layout: ResearchGridItem;
    anchorId?: string;
};

type PaperProps = BaseProps & {
    collection: "papers";
    summary: string;
    tags: string[];
    authors: string[];
    venue: string;
    year: number;
    status: PaperStatus;
    doi?: string | null;
    arxiv?: string | null;
};

type RepoProps = BaseProps & {
    collection: "repos";
    description: string;
    url: string;
    topics: string[];
    stack: string[];
    language: string;
};

type Props = PaperProps | RepoProps;

const SELF_AUTHOR = "Ludovic K. Tuncay";

const props = Astro.props as Props;
const href = getResearchDetailHref(props.collection, props.slug);
const typeLabel =
    props.collection === "papers" ? "publication" : "code repository";

const accentVar =
    props.collection === "papers"
        ? "var(--color-accent)"
        : "var(--color-accent-secondary)";
const layoutStyle = `--desktop-span:${props.layout.desktop.span};--tablet-span:${props.layout.tablet.span};--item-order:${props.layout.order};--card-accent:${accentVar};`;

const isFeature = props.layout.variant === "feature";
const hasPreview = Boolean(props.preview) && props.layout.variant !== "compact";
const isPortfolio = props.collection === "repos" && props.slug === "portfolio";
const hasStarsSticker =
    props.collection === "repos" && props.slug === "audio-jepa";

const sizeClass = isFeature
    ? "min-h-[17rem]"
    : props.layout.variant === "wide"
      ? "min-h-[16rem]"
      : "min-h-[15rem]";

const titleClass = isFeature
    ? "text-[clamp(1.35rem,2vw,2rem)]"
    : props.layout.variant === "wide"
      ? "text-[clamp(1.2rem,1.5vw,1.55rem)]"
      : "text-[clamp(1.1rem,1.35vw,1.35rem)]";

const authorsWithSelf =
    props.collection === "papers"
        ? props.authors.map((author) => ({
              name: author,
              isSelf: author === SELF_AUTHOR,
          }))
        : null;

const readPaperHref =
    props.collection === "papers" ? (props.doi ?? props.arxiv ?? href) : null;

const repoTags =
    props.collection === "repos"
        ? Array.from(new Set([props.language, ...props.stack, ...props.topics]))
        : [];
---

<article
    id={props.anchorId}
    style={layoutStyle}
    class:list={[
        "relative flex h-full flex-col gap-5 border border-[var(--color-divider)] bg-[var(--color-surface)] p-5 md:p-6",
        sizeClass,
        "[grid-column:span_1_/_span_1] [order:var(--item-order)] md:[grid-column:span_var(--tablet-span)_/_span_var(--tablet-span)] xl:[grid-column:span_var(--desktop-span)_/_span_var(--desktop-span)]",
    ]}
>
    <header class="flex items-start justify-between gap-3">
        <div class="flex min-w-0 flex-col gap-2">
            <span class="ui-copy text-[var(--color-ink)]">
                {typeLabel}
            </span>
            {
                props.collection === "papers" ? (
                    <span class="ui-copy text-[var(--color-ink-muted)]">
                        {props.venue} {props.year}
                        <span
                            class="mx-2 text-[var(--color-divider)]"
                            aria-hidden="true"
                        >
                            /
                        </span>
                        <span class="text-[var(--color-ink)]">
                            {paperStatusLabels[props.status]}
                        </span>
                    </span>
                ) : null
            }
        </div>

        {
            hasStarsSticker && (
                <div class="ui-copy rotate-20 border border-[var(--color-accent-secondary)] bg-[color-mix(in_srgb,var(--color-accent)_5%,var(--color-surface))] px-3 py-2 text-[var(--color-ink)] shadow-[var(--shadow-button-primary)]">
                    50+ ⭐️
                </div>
            )
        }
    </header>

    <div
        class:list={[
            "flex flex-1 gap-5",
            isFeature || props.collection === "papers"
                ? "flex-col md:flex-row md:items-stretch"
                : "flex-col",
            isPortfolio
                ? "md:grid md:grid-cols-[minmax(0,1fr)_minmax(14rem,0.85fr)] md:items-center"
                : "",
        ]}
    >
        {
            hasPreview && (
                <div
                    class:list={[
                        "flex shrink-0 items-center",
                        isFeature || props.collection === "papers"
                            ? "md:order-2 md:basis-[34%]"
                            : "",
                        isPortfolio ? "md:basis-auto" : "",
                    ]}
                >
                    <ResearchPreviewCard
                        preview={props.preview!}
                        variant={props.layout.variant}
                        collection={props.collection}
                        slug={props.slug}
                    />
                </div>
            )
        }

        <div
            class:list={[
                "flex flex-1 flex-col gap-6",
                isFeature || props.collection === "papers" ? "md:order-1" : "",
            ]}
        >
            <div class="space-y-6">
                <h2
                    class:list={[
                        titleClass,
                        props.collection === "repos"
                            ? "research-repo-title"
                            : "research-paper-title",
                    ]}
                >
                    {props.title}
                </h2>

                {
                    props.collection === "papers" ? (
                        <p class="body-copy max-w-[36rem] !text-[clamp(0.86rem,1.1vw,0.95rem)]">
                            {props.summary}
                        </p>
                    ) : (
                        <p class="body-copy max-w-[34rem] !text-[clamp(0.86rem,1.1vw,0.95rem)]">
                            {props.description}
                        </p>
                    )
                }
            </div>

            <div class="space-y-5">
                {
                    props.collection === "papers" ? (
                        <>
                            <p class="meta-copy !text-[clamp(0.82rem,1vw,0.92rem)]">
                                {authorsWithSelf!.map((author, index) => (
                                    <span>
                                        {author.isSelf ? (
                                            <strong class="font-[var(--font-body)] font-[800] not-italic text-[var(--color-ink)]">
                                                {author.name}
                                            </strong>
                                        ) : (
                                            author.name
                                        )}
                                        {index < authorsWithSelf!.length - 1
                                            ? ", "
                                            : ""}
                                    </span>
                                ))}
                            </p>
                            <div class="flex flex-wrap gap-3 pt-2">
                                <a
                                    href={readPaperHref!}
                                    class="button-shell button-primary !gap-1.5 !px-3 !py-2"
                                    target={
                                        readPaperHref === href
                                            ? undefined
                                            : "_blank"
                                    }
                                    rel={
                                        readPaperHref === href
                                            ? undefined
                                            : "noreferrer"
                                    }
                                >
                                    <FileText class="h-4 w-4" aria-hidden="true" stroke-width={2.1} />
                                    Read paper
                                </a>
                                <a
                                    href={href}
                                    class="button-shell button-muted !px-3 !py-2"
                                >
                                    Details
                                </a>
                            </div>
                        </>
                    ) : (
                        <div class="space-y-4">
                            <div class="flex flex-wrap gap-3">
                                <a
                                    href={props.url}
                                    class="button-shell button-primary !gap-1.5 !px-3 !py-2"
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.59c1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
                                    </svg>
                                    GitHub
                                </a>
                                <a
                                    href={href}
                                    class="button-shell button-muted !px-3 !py-2"
                                >
                                    Details
                                </a>
                            </div>
                            <div class="tag-list">
                                {repoTags.map((tag) => (
                                    <span class="tag-chip tag-chip-muted">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</article>
