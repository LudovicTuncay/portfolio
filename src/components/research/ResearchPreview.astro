---
import { Image } from "astro:assets";
import type { ResearchCardVariant } from "../../data/research-grid";
import type {
    ResearchCollectionKey,
    ResearchPreview as PreviewData,
} from "../../data/research";
import portfolioPreviewDesktopDark from "../../assets/portfolio-preview/portfolio-preview-desktop-dark.webp";
import portfolioPreviewDesktop from "../../assets/portfolio-preview/portfolio-preview-desktop.webp";
import portfolioPreviewMobileDark from "../../assets/portfolio-preview/portfolio-preview-mobile-dark.webp";
import portfolioPreviewMobile from "../../assets/portfolio-preview/portfolio-preview-mobile.webp";

type Props = {
    preview: PreviewData;
    variant?: ResearchCardVariant;
    collection?: ResearchCollectionKey;
    slug?: string;
};

const { preview, variant = "wide", collection, slug } = Astro.props;
const isPaper = collection === "papers";
const isRepo = collection === "repos";
const isPortfolio = isRepo && slug === "portfolio";

const frameClass =
    variant === "feature"
        ? isPaper
            ? "min-h-[8rem] md:h-full md:min-h-[12rem]"
            : "min-h-[9rem] md:h-full md:min-h-[11rem]"
        : isPaper
          ? "min-h-[7rem] md:min-h-[9rem]"
          : isPortfolio
            ? "min-h-[12.5rem] md:min-h-[14.75rem]"
            : "min-h-[7rem] md:min-h-[8rem]";
---

<div
    class:list={[
        "relative flex w-full flex-col overflow-hidden",
        isPaper
            ? "bg-transparent p-0"
            : isPortfolio
              ? "bg-transparent p-0"
              : "border border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-surface)_94%,var(--card-accent,var(--color-accent))_6%)] p-4",
        frameClass,
    ]}
>
    {
        !isPaper && !isPortfolio && (
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,color-mix(in_srgb,var(--card-accent,var(--color-accent))_10%,transparent),transparent_58%)]" />
        )
    }

    <div class="relative flex flex-1 items-center justify-center">
        {
            isPaper && preview.style === "waveform" && (
                <svg
                    aria-hidden="true"
                    viewBox="0 0 320 150"
                    class="h-[8rem] w-full max-w-[18rem] text-[var(--card-accent,var(--color-accent))]"
                    fill="none"
                >
                    <path
                        d="M24 126V82M44 126V54M64 126V96M84 126V36M104 126V72M124 126V18M144 126V64M164 126V30M184 126V84M204 126V44M224 126V22M244 126V70M264 126V38M284 126V90"
                        stroke="currentColor"
                        stroke-width="2"
                    />
                    <path
                        d="M20 126H292"
                        stroke="var(--color-divider)"
                        stroke-width="1"
                    />
                </svg>
            )
        }

        {
            isPaper && preview.style === "signal" && (
                <svg
                    aria-hidden="true"
                    viewBox="0 0 300 140"
                    class="h-[8rem] w-full max-w-[18rem] text-[var(--color-ink-muted)]"
                    fill="none"
                >
                    <path
                        d="M18 74c20 0 20-32 40-32s20 58 40 58 20-72 40-72 20 84 40 84 20-56 40-56 20 18 40 18"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                    />
                    <circle
                        cx="58"
                        cy="42"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="138"
                        cy="28"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="218"
                        cy="56"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="274"
                        cy="74"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                </svg>
            )
        }

        {
            isPaper && preview.style === "grid" && (
                <div class="grid w-full max-w-[12rem] grid-cols-4 gap-2">
                    {Array.from({ length: 16 }).map((_, index) => (
                        <div
                            class:list={[
                                "aspect-square border",
                                index % 5 === 0 || index % 7 === 0
                                    ? "border-[var(--color-accent-secondary)] bg-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]"
                                    : "border-[var(--color-divider)] bg-transparent",
                            ]}
                        />
                    ))}
                </div>
            )
        }

        {
            isPortfolio && (
                <div class="relative flex min-h-[12rem] w-full items-center justify-center py-1 md:min-h-[14.5rem]">
                    <div class="relative w-full max-w-[42rem]">
                        <div class="portfolio-browser-mockup relative isolate w-[84%] overflow-hidden rounded-[0.85rem] border border-[color-mix(in_srgb,var(--color-divider)_72%,var(--card-accent,var(--color-accent)))] bg-[color-mix(in_srgb,var(--color-surface)_82%,var(--card-accent,var(--color-accent))_8%)] shadow-[0_14px_30px_rgb(0_0_0_/_14%)] [clip-path:inset(0_round_0.85rem)] [contain:paint]">
                            <div class="relative z-10 flex h-5 items-center gap-1.5 bg-[color-mix(in_srgb,var(--color-surface)_82%,var(--card-accent,var(--color-accent))_8%)] px-2 md:h-6 md:px-2.5">
                                <span class="h-1.5 w-1.5 rounded-full bg-[#ff6b68]" />
                                <span class="h-1.5 w-1.5 rounded-full bg-[#f6c85f]" />
                                <span class="h-1.5 w-1.5 rounded-full bg-[#62c983]" />
                                <div class="ml-2 flex h-3 flex-1 items-center justify-center rounded bg-[color-mix(in_srgb,var(--color-surface)_86%,var(--color-divider))] font-[var(--font-ui)] text-[5px] text-[var(--color-ink-muted)] md:h-3.5 md:text-[6px]">
                                    lkt.dev
                                </div>
                            </div>

                            <div
                                class="portfolio-browser-screen relative -mt-px aspect-[1440/846] w-full overflow-hidden rounded-b-[0.68rem] bg-[var(--color-surface)] [clip-path:inset(0_round_0_0_0.68rem_0.68rem)] [contain:paint]"
                            >
                                <Image
                                    src={portfolioPreviewDesktop}
                                    alt="Static desktop preview of the portfolio home page"
                                    class="portfolio-preview-light h-full w-full object-contain object-top"
                                    layout="constrained"
                                    width={1440}
                                    height={846}
                                    sizes="(min-width: 768px) 565px, 84vw"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <Image
                                    src={portfolioPreviewDesktopDark}
                                    alt="Static desktop preview of the portfolio home page in dark mode"
                                    class="portfolio-preview-dark hidden h-full w-full object-contain object-top"
                                    layout="constrained"
                                    width={1440}
                                    height={846}
                                    sizes="(min-width: 768px) 565px, 84vw"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>

                        <div class="portfolio-phone-mockup absolute bottom-[0.12rem] right-[1%] isolate flex w-[clamp(4.15rem,22vw,5rem)] flex-col overflow-hidden rounded-[0.9rem] border-2 border-black bg-black shadow-[0_12px_24px_rgb(0_0_0_/_22%)] [clip-path:inset(0_round_0.9rem)] [contain:paint] sm:right-[4%] sm:w-[clamp(4.7rem,21vw,5.7rem)] md:bottom-[-0.25rem] md:right-[6%] md:w-[24%] md:max-w-[6.8rem] md:rounded-[1.15rem] md:border-[3px] md:[clip-path:inset(0_round_1.15rem)]">
                            <div
                                aria-hidden="true"
                                class="relative z-20 h-[0.82rem] shrink-0 bg-[var(--color-surface)] sm:h-[0.96rem] md:h-[1.28rem]"
                            >
                                <div class="absolute left-1/2 top-1/2 h-[0.32rem] w-[1.38rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-black sm:h-[0.38rem] sm:w-[1.62rem] md:h-[0.43rem] md:w-[1.75rem]" />
                            </div>
                            <div
                                class="relative -mt-px aspect-[390/845] w-full overflow-hidden rounded-b-[0.78rem] bg-[var(--color-surface)] [clip-path:inset(0_round_0_0_0.78rem_0.78rem)] [contain:paint] md:rounded-b-[0.92rem] md:[clip-path:inset(0_round_0_0_0.92rem_0.92rem)]"
                            >
                                <Image
                                    src={portfolioPreviewMobile}
                                    alt="Static mobile preview of the portfolio home page"
                                    class="portfolio-preview-light h-full w-full object-contain object-top"
                                    layout="constrained"
                                    width={390}
                                    height={845}
                                    sizes="(min-width: 768px) 109px, (min-width: 640px) 91px, 80px"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <Image
                                    src={portfolioPreviewMobileDark}
                                    alt="Static mobile preview of the portfolio home page in dark mode"
                                    class="portfolio-preview-dark hidden h-full w-full object-contain object-top"
                                    layout="constrained"
                                    width={390}
                                    height={845}
                                    sizes="(min-width: 768px) 109px, (min-width: 640px) 91px, 80px"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            )
        }

        {
            isRepo && !isPortfolio && (
                <div class="w-full font-[var(--font-ui)] text-[12px] leading-[1.35] text-[var(--color-ink-muted)]">
                    <div class="mb-3 flex items-center justify-between border-b border-[var(--color-divider)] pb-2">
                        <span class="text-[var(--color-ink)]">{slug}/</span>
                        <span>{preview.label?.split(" · ")[0] ?? "repo"}</span>
                    </div>
                    <div class="space-y-1">
                        {(slug === "hierarchical-label-propagation"
                            ? [
                                  "hlp/",
                                  "taxonomy/",
                                  "propagation.py",
                                  "metrics.py",
                              ]
                            : ["encoders/", "conf/", "train.py", "eval.py"]
                        ).map((line, index) => (
                            <div class="flex items-center gap-2">
                                <span class="text-[var(--color-divider)]">
                                    {index === 0 ? "└" : "├"}
                                </span>
                                <span>{line}</span>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        {
            !isPaper && !isRepo && preview.style === "waveform" && (
                <svg
                    aria-hidden="true"
                    viewBox="0 0 320 96"
                    class="h-[4.5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[5.5rem] md:w-[18rem]"
                    fill="none"
                >
                    <path
                        d="M8 48h10m6 0h4v-4h4v8h4V40h4v16h4V36h4v24h4V28h4v40h4V24h4v48h4V20h4v56h4V18h4v60h4V22h4v52h4V26h4v44h4V30h4v36h4V34h4v28h4V38h4v20h4V42h4v12h4V46h12"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="square"
                    />
                </svg>
            )
        }

        {
            !isPaper && !isRepo && preview.style === "terminal" && (
                <div class="flex w-full flex-col gap-3">
                    <div class="flex gap-2">
                        <span class="h-2.5 w-2.5 rounded-full bg-[var(--card-accent,var(--color-accent))]" />
                        <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_20%,transparent)]" />
                        <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_10%,transparent)]" />
                    </div>
                    <div class="space-y-1.5 font-[var(--font-ui)] text-[13px] leading-tight text-[var(--color-ink-muted)]">
                        <div class="w-[78%] border-b border-dashed border-[var(--color-divider)] pb-1">
                            train model=audio-jepa
                        </div>
                        <div class="w-[62%] border-b border-dashed border-[var(--color-divider)] pb-1">
                            eval suite=xares
                        </div>
                        <div class="w-[48%] border-b border-dashed border-[var(--color-divider)] pb-1">
                            ckpt=best-rq2
                        </div>
                    </div>
                </div>
            )
        }

        {
            !isPaper && !isRepo && preview.style === "grid" && (
                <div class="grid w-full max-w-[16rem] grid-cols-4 gap-2">
                    {Array.from({ length: 16 }).map((_, index) => (
                        <div
                            class:list={[
                                "aspect-square border border-dashed",
                                index % 5 === 0 || index % 7 === 0
                                    ? "border-[var(--color-ink)] bg-[color-mix(in_srgb,var(--card-accent,var(--color-accent))_18%,transparent)]"
                                    : "border-[var(--color-divider)] bg-transparent",
                            ]}
                        />
                    ))}
                </div>
            )
        }

        {
            !isPaper && !isRepo && preview.style === "signal" && (
                <svg
                    aria-hidden="true"
                    viewBox="0 0 300 120"
                    class="h-[5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[6rem] md:w-[16rem]"
                    fill="none"
                >
                    <path
                        d="M10 62c18 0 18-28 36-28s18 52 36 52 18-64 36-64 18 76 36 76 18-52 36-52 18 16 36 16"
                        stroke="currentColor"
                        stroke-width="3"
                    />
                    <circle
                        cx="46"
                        cy="34"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="118"
                        cy="22"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="190"
                        cy="98"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                    <circle
                        cx="262"
                        cy="62"
                        r="4"
                        fill="var(--card-accent,var(--color-accent))"
                        stroke="var(--color-ink)"
                        stroke-width="1.5"
                    />
                </svg>
            )
        }
    </div>

    {
        preview.label && !isPaper && !isPortfolio && (
            <p class="relative mt-3 font-[var(--font-ui)] text-[12px] lowercase tracking-[0.05em] text-[var(--color-ink-muted)]">
                {preview.label}
            </p>
        )
    }
</div>

<style>
    :global(html.dark) .portfolio-preview-light {
        display: none;
    }

    :global(html.dark) .portfolio-preview-dark {
        display: block;
    }
</style>
