---
import type { ResearchCardVariant } from "../../data/research-grid";
import type { ResearchCollectionKey, ResearchPreview as PreviewData } from "../../data/research";

type Props = {
  preview: PreviewData;
  variant?: ResearchCardVariant;
  collection?: ResearchCollectionKey;
  slug?: string;
};

const { preview, variant = "wide", collection, slug } = Astro.props;
const isPaper = collection === "papers";
const isRepo = collection === "repos";
const isPortfolio = isRepo && slug === "portfolio";

const frameClass =
  variant === "feature"
    ? isPaper
      ? "min-h-[8rem] md:h-full md:min-h-[12rem]"
      : "min-h-[9rem] md:h-full md:min-h-[11rem]"
    : isPaper
      ? "min-h-[7rem] md:min-h-[9rem]"
      : isPortfolio
        ? "min-h-[10rem] md:min-h-[12rem]"
        : "min-h-[7rem] md:min-h-[8rem]";
---

<div
  class:list={[
    "relative flex w-full flex-col overflow-hidden",
    isPaper
      ? "bg-transparent p-0"
      : "border border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-surface)_94%,var(--card-accent,var(--color-accent))_6%)] p-4",
    frameClass
  ]}
>
  {!isPaper && (
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,color-mix(in_srgb,var(--card-accent,var(--color-accent))_10%,transparent),transparent_58%)]"></div>
  )}

  <div class="relative flex flex-1 items-center justify-center">
    {
      isPaper && preview.style === "waveform" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 320 150"
          class="h-[8rem] w-full max-w-[18rem] text-[var(--card-accent,var(--color-accent))]"
          fill="none"
        >
          <path
            d="M24 126V82M44 126V54M64 126V96M84 126V36M104 126V72M124 126V18M144 126V64M164 126V30M184 126V84M204 126V44M224 126V22M244 126V70M264 126V38M284 126V90"
            stroke="currentColor"
            stroke-width="2"
          />
          <path
            d="M20 126H292"
            stroke="var(--color-divider)"
            stroke-width="1"
          />
        </svg>
      )
    }

    {
      isPaper && preview.style === "signal" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 300 140"
          class="h-[8rem] w-full max-w-[18rem] text-[var(--color-ink-muted)]"
          fill="none"
        >
          <path
            d="M18 74c20 0 20-32 40-32s20 58 40 58 20-72 40-72 20 84 40 84 20-56 40-56 20 18 40 18"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
          <circle cx="58" cy="42" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="138" cy="28" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="218" cy="56" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="274" cy="74" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
        </svg>
      )
    }

    {
      isPaper && preview.style === "grid" && (
        <div class="grid w-full max-w-[12rem] grid-cols-4 gap-2">
          {Array.from({ length: 16 }).map((_, index) => (
            <div
              class:list={[
                "aspect-square border",
                index % 5 === 0 || index % 7 === 0
                  ? "border-[var(--color-accent-secondary)] bg-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]"
                  : "border-[var(--color-divider)] bg-transparent"
              ]}
            />
          ))}
        </div>
      )
    }

    {
      isPortfolio && (
        <div class="relative flex min-h-[11rem] w-full items-end justify-center px-2 pt-4">
          <div class="relative w-[78%] max-w-[22rem] border border-[var(--color-divider)] bg-[var(--color-surface)] p-2 shadow-[var(--shadow-button-muted)]">
            <div class="mb-2 flex items-center justify-between border-b border-[var(--color-divider)] pb-1.5 font-[var(--font-ui)] text-[9px] text-[var(--color-ink-muted)]">
              <span>.lkt</span>
              <span>Home&nbsp;&nbsp;Research&nbsp;&nbsp;Photo</span>
            </div>
            <div class="grid grid-cols-[0.9fr_1fr] gap-2">
              <div class="space-y-1.5">
                <div class="h-3 w-14 bg-[var(--color-ink)]"></div>
                <div class="h-2 w-20 bg-[var(--color-divider)]"></div>
                <div class="h-2 w-16 bg-[var(--color-divider)]"></div>
                <div class="mt-2 h-4 w-12 border border-[var(--color-ink)]"></div>
              </div>
              <div class="h-20 border border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-accent)_18%,var(--color-surface))]"></div>
            </div>
          </div>

          <div class="absolute bottom-0 right-[6%] h-[8.5rem] w-[4.2rem] rounded-[0.8rem] border-2 border-[var(--color-ink)] bg-[var(--color-surface)] p-1 shadow-[var(--shadow-button-muted)]">
            <div class="mx-auto mb-1 h-1 w-5 rounded-full bg-[var(--color-ink)]"></div>
            <div class="h-[6.8rem] border border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-accent)_12%,var(--color-surface))] p-1">
              <div class="mb-1 h-2 w-8 bg-[var(--color-ink)]"></div>
              <div class="mb-1 h-1.5 w-9 bg-[var(--color-divider)]"></div>
              <div class="h-8 border border-[var(--color-divider)]"></div>
            </div>
          </div>
        </div>
      )
    }

    {
      isRepo && !isPortfolio && (
        <div class="w-full font-[var(--font-ui)] text-[12px] leading-[1.35] text-[var(--color-ink-muted)]">
          <div class="mb-3 flex items-center justify-between border-b border-[var(--color-divider)] pb-2">
            <span class="text-[var(--color-ink)]">{slug}/</span>
            <span>{preview.label?.split(" · ")[0] ?? "repo"}</span>
          </div>
          <div class="space-y-1">
            {(slug === "hierarchical-label-propagation"
                ? ["hlp/", "taxonomy/", "propagation.py", "metrics.py"]
                : ["encoders/", "conf/", "train.py", "eval.py"]
            ).map((line, index) => (
              <div class="flex items-center gap-2">
                <span class="text-[var(--color-divider)]">{index === 0 ? "└" : "├"}</span>
                <span>{line}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      !isPaper && !isRepo && preview.style === "waveform" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 320 96"
          class="h-[4.5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[5.5rem] md:w-[18rem]"
          fill="none"
        >
          <path
            d="M8 48h10m6 0h4v-4h4v8h4V40h4v16h4V36h4v24h4V28h4v40h4V24h4v48h4V20h4v56h4V18h4v60h4V22h4v52h4V26h4v44h4V30h4v36h4V34h4v28h4V38h4v20h4V42h4v12h4V46h12"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="square"
          />
        </svg>
      )
    }

    {
      !isPaper && !isRepo && preview.style === "terminal" && (
        <div class="flex w-full flex-col gap-3">
          <div class="flex gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--card-accent,var(--color-accent))]" />
            <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_20%,transparent)]" />
            <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_10%,transparent)]" />
          </div>
          <div class="space-y-1.5 font-[var(--font-ui)] text-[13px] leading-tight text-[var(--color-ink-muted)]">
            <div class="w-[78%] border-b border-dashed border-[var(--color-divider)] pb-1">train model=audio-jepa</div>
            <div class="w-[62%] border-b border-dashed border-[var(--color-divider)] pb-1">eval suite=xares</div>
            <div class="w-[48%] border-b border-dashed border-[var(--color-divider)] pb-1">ckpt=best-rq2</div>
          </div>
        </div>
      )
    }

    {
      !isPaper && !isRepo && preview.style === "grid" && (
        <div class="grid w-full max-w-[16rem] grid-cols-4 gap-2">
          {Array.from({ length: 16 }).map((_, index) => (
            <div
              class:list={[
                "aspect-square border border-dashed",
                index % 5 === 0 || index % 7 === 0
                  ? "border-[var(--color-ink)] bg-[color-mix(in_srgb,var(--card-accent,var(--color-accent))_18%,transparent)]"
                  : "border-[var(--color-divider)] bg-transparent"
              ]}
            />
          ))}
        </div>
      )
    }

    {
      !isPaper && !isRepo && preview.style === "signal" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 300 120"
          class="h-[5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[6rem] md:w-[16rem]"
          fill="none"
        >
          <path
            d="M10 62c18 0 18-28 36-28s18 52 36 52 18-64 36-64 18 76 36 76 18-52 36-52 18 16 36 16"
            stroke="currentColor"
            stroke-width="3"
          />
          <circle cx="46" cy="34" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="118" cy="22" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="190" cy="98" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="262" cy="62" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
        </svg>
      )
    }
  </div>

  {
    preview.label && !isPaper && (
      <p class="relative mt-3 font-[var(--font-ui)] text-[12px] lowercase tracking-[0.05em] text-[var(--color-ink-muted)]">
        {preview.label}
      </p>
    )
  }
</div>
