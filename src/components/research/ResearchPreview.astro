---
import type { ResearchCardVariant } from "../../data/research-grid";
import type { ResearchPreview as PreviewData } from "../../data/research";

type Props = {
  preview: PreviewData;
  variant?: ResearchCardVariant;
};

const { preview, variant = "wide" } = Astro.props;

const frameClass =
  variant === "feature"
    ? "min-h-[10rem] md:h-full md:min-h-[14rem]"
    : "min-h-[7rem] md:min-h-[8rem]";
---

<div
  class:list={[
    "relative flex w-full flex-col overflow-hidden border border-dashed border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-surface)_92%,var(--card-accent,var(--color-accent))_8%)] p-4",
    frameClass
  ]}
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,color-mix(in_srgb,var(--card-accent,var(--color-accent))_14%,transparent),transparent_55%)]"></div>

  <div class="relative flex flex-1 items-center justify-center">
    {
      preview.style === "waveform" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 320 96"
          class="h-[4.5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[5.5rem] md:w-[18rem]"
          fill="none"
        >
          <path
            d="M8 48h10m6 0h4v-4h4v8h4V40h4v16h4V36h4v24h4V28h4v40h4V24h4v48h4V20h4v56h4V18h4v60h4V22h4v52h4V26h4v44h4V30h4v36h4V34h4v28h4V38h4v20h4V42h4v12h4V46h12"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="square"
          />
        </svg>
      )
    }

    {
      preview.style === "terminal" && (
        <div class="flex w-full flex-col gap-3">
          <div class="flex gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--card-accent,var(--color-accent))]" />
            <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_20%,transparent)]" />
            <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_srgb,var(--color-ink)_10%,transparent)]" />
          </div>
          <div class="space-y-1.5 font-[var(--font-ui)] text-[13px] leading-tight text-[var(--color-ink-muted)]">
            <div class="w-[78%] border-b border-dashed border-[var(--color-divider)] pb-1">train model=audio-jepa</div>
            <div class="w-[62%] border-b border-dashed border-[var(--color-divider)] pb-1">eval suite=xares</div>
            <div class="w-[48%] border-b border-dashed border-[var(--color-divider)] pb-1">ckpt=best-rq2</div>
          </div>
        </div>
      )
    }

    {
      preview.style === "grid" && (
        <div class="grid w-full max-w-[16rem] grid-cols-4 gap-2">
          {Array.from({ length: 16 }).map((_, index) => (
            <div
              class:list={[
                "aspect-square border border-dashed",
                index % 5 === 0 || index % 7 === 0
                  ? "border-[var(--color-ink)] bg-[color-mix(in_srgb,var(--card-accent,var(--color-accent))_18%,transparent)]"
                  : "border-[var(--color-divider)] bg-transparent"
              ]}
            />
          ))}
        </div>
      )
    }

    {
      preview.style === "signal" && (
        <svg
          aria-hidden="true"
          viewBox="0 0 300 120"
          class="h-[5rem] w-[14rem] text-[var(--color-ink-muted)] md:h-[6rem] md:w-[16rem]"
          fill="none"
        >
          <path
            d="M10 62c18 0 18-28 36-28s18 52 36 52 18-64 36-64 18 76 36 76 18-52 36-52 18 16 36 16"
            stroke="currentColor"
            stroke-width="3"
          />
          <circle cx="46" cy="34" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="118" cy="22" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="190" cy="98" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
          <circle cx="262" cy="62" r="4" fill="var(--card-accent,var(--color-accent))" stroke="var(--color-ink)" stroke-width="1.5" />
        </svg>
      )
    }
  </div>

  {
    preview.label && (
      <p class="relative mt-3 font-[var(--font-ui)] text-[12px] lowercase tracking-[0.05em] text-[var(--color-ink-muted)]">
        {preview.label}
      </p>
    )
  }
</div>
