---
type Props = {
  showLabel?: boolean;
  className?: string;
};

const { showLabel = false, className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    "button-shell button-primary",
    showLabel ? "w-full justify-start gap-3" : "button-icon",
    className
  ]}
  aria-label="Theme toggle coming soon"
  title="Theme toggle coming soon"
>
  <svg
    aria-hidden="true"
    class="h-[24px] w-[24px] shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>

  {showLabel ? (
    <span class="ui-copy">Switch to dark mode</span>
  ) : (
    <span class="sr-only">Switch to dark mode</span>
  )}
</button>
