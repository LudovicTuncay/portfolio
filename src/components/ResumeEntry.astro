---
import ButtonLink from "./ButtonLink.astro";

type Props = {
  title: string;
  subtitle: string;
  bullets: string[];
  date: string;
  location: string;
  href?: string;
};

const { title, subtitle, bullets, date, location, href } = Astro.props;
---

<article
  class:list={[
    "grid gap-5 py-4 md:items-start md:gap-5",
    href
      ? "md:grid-cols-[minmax(0,1fr)_190px_30px]"
      : "md:grid-cols-[minmax(0,1fr)_190px]",
  ]}
>
  <div class="space-y-5">
    <h4 class="entry-title">{title}</h4>
    <p class="meta-copy" set:html={subtitle}></p>
    <ul class="body-copy list-disc space-y-0 pl-[1.7rem]">
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  </div>

  <div class="space-y-1 text-left md:text-right">
    <p class="body-copy">{date}</p>
    <p class="meta-copy">{location}</p>
  </div>

  {
    href && (
      <div class="md:justify-self-end">
        <ButtonLink href={href} label="Open" muted icon external />
      </div>
    )
  }
</article>
