---
---

<div class="bg-blobs" aria-hidden="true">
  <span class="blob blob-a"></span>
  <span class="blob blob-b"></span>
  <span class="blob blob-c"></span>
</div>

<style>
  .bg-blobs {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    width: 55vmax;
    height: 55vmax;
    border-radius: 50%;
    filter: blur(90px);
    mix-blend-mode: multiply;
    will-change: transform;
  }

  .blob-a {
    background: radial-gradient(
      circle,
      rgb(253 199 0 / 62%) 0%,
      rgb(253 199 0 / 0%) 65%
    );
    top: -15vmax;
    left: -10vmax;
    animation: drift-a 17s ease-in-out infinite;
  }

  .blob-b {
    background: radial-gradient(
      circle,
      rgb(255 155 61 / 55%) 0%,
      rgb(255 155 61 / 0%) 65%
    );
    bottom: -20vmax;
    right: -15vmax;
    animation: drift-b 23s ease-in-out infinite;
  }

  .blob-c {
    background: radial-gradient(
      circle,
      rgb(255 184 112 / 50%) 0%,
      rgb(255 184 112 / 0%) 65%
    );
    top: 30%;
    left: 35%;
    animation: drift-c 13s ease-in-out infinite;
  }

  @keyframes drift-a {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    18%  { transform: translate3d(22vw, 6vh, 0) scale(1.15); }
    36%  { transform: translate3d(34vw, 24vh, 0) scale(1.3); }
    55%  { transform: translate3d(18vw, 32vh, 0) scale(1.05); }
    74%  { transform: translate3d(-6vw, 16vh, 0) scale(1.2); }
    88%  { transform: translate3d(4vw, 4vh, 0) scale(0.95); }
    100% { transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes drift-b {
    0%   { transform: translate3d(0, 0, 0) scale(1.1); }
    15%  { transform: translate3d(-14vw, -10vh, 0) scale(0.95); }
    32%  { transform: translate3d(-30vw, -16vh, 0) scale(1.05); }
    50%  { transform: translate3d(-24vw, -32vh, 0) scale(1.25); }
    68%  { transform: translate3d(-6vw, -28vh, 0) scale(1); }
    84%  { transform: translate3d(6vw, -10vh, 0) scale(0.9); }
    100% { transform: translate3d(0, 0, 0) scale(1.1); }
  }

  @keyframes drift-c {
    0%   { transform: translate3d(-16vw, 12vh, 0) scale(0.85); }
    17%  { transform: translate3d(2vw, 20vh, 0) scale(1.1); }
    34%  { transform: translate3d(22vw, 4vh, 0) scale(1.25); }
    51%  { transform: translate3d(14vw, -18vh, 0) scale(0.95); }
    68%  { transform: translate3d(-10vw, -16vh, 0) scale(1.15); }
    85%  { transform: translate3d(-22vw, -2vh, 0) scale(1); }
    100% { transform: translate3d(-16vw, 12vh, 0) scale(0.85); }
  }
</style>
