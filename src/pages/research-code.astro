---
import { getCollection } from "astro:content";
import {
  AudioLines,
  BrainCircuit,
  ChartNoAxesColumnIncreasing,
  CodeXml,
  DatabaseZap
} from "@lucide/astro";
import ResearchBentoGrid from "../components/research/ResearchBentoGrid.astro";
import ResearchCard from "../components/research/ResearchCard.astro";
import { researchGrid } from "../data/research-grid";
import BaseLayout from "../layouts/BaseLayout.astro";

const [papers, repos] = await Promise.all([getCollection("papers"), getCollection("repos")]);

const papersById = new Map(papers.map((entry) => [entry.id, entry]));
const reposById = new Map(repos.map((entry) => [entry.id, entry]));

const orderedItems = researchGrid
  .slice()
  .sort((left, right) => left.order - right.order)
  .map((layout) => {
    const entry =
      layout.collection === "papers" ? papersById.get(layout.slug) : reposById.get(layout.slug);

    if (!entry) {
      throw new Error(`Missing research entry for ${layout.collection}/${layout.slug}`);
    }

    return { entry, layout };
  });

const firstPaperId = orderedItems.find(({ entry }) => entry.collection === "papers")?.entry.id;
const firstRepoId = orderedItems.find(({ entry }) => entry.collection === "repos")?.entry.id;

const researchInterests = [
  { label: "SSL", Icon: BrainCircuit },
  { label: "Audio embeddings", Icon: AudioLines },
  { label: "Evaluation and benchmarking", Icon: ChartNoAxesColumnIncreasing },
  { label: "Dataset curation/correction", Icon: DatabaseZap },
  { label: "Open-source systems and tools", Icon: CodeXml }
];

const quickLinks = [
  { href: "https://scholar.google.com", label: "Google Scholar", external: true, icon: "scholar" },
  { href: "https://github.com/LudovicTuncay", label: "GitHub", external: true, icon: "github" },
  { href: "https://hal.science", label: "HAL", external: true, icon: "hal" }
];
---

<BaseLayout
  title="LKT | Research & Code"
  currentPath="/research-code"
  description="Research and code page for Ludovic K. TUNCAY."
>
  <section class="page-container pt-12 md:pt-16">
    <div class="space-y-8 md:space-y-10">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.75fr)] md:items-start">
        <div class="space-y-6">
          <h1 class="display-title accent-glow">Research &amp; Code</h1>
          <p class="body-copy max-w-[42rem]">
            Papers, open-source systems, and tools. Most of my work explores
            self-supervised learning for audio representation and its applications.
          </p>

        </div>

        <aside class="border-t border-[var(--color-divider)] pt-6 md:border-l md:border-t-0 md:pl-10 md:pt-0">
          <h2 class="ui-copy mb-5 text-[var(--color-ink)]">Research interests</h2>
          <ul role="list" class="space-y-4">
            {researchInterests.map(({ label, Icon }) => (
              <li class="flex items-center gap-4">
                <Icon class="h-5 w-5 shrink-0 text-[var(--color-ink)]" aria-hidden="true" stroke-width={1.8} />
                <span class="body-copy text-[clamp(0.95rem,1.3vw,1rem)]">{label}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>

      <nav
        aria-label="Quick links"
        class="inline-flex max-w-full flex-wrap border border-[var(--color-divider)] bg-[color-mix(in_srgb,var(--color-surface)_96%,var(--color-accent)_4%)]"
      >
        <p class="entry-title border-r border-[var(--color-divider)] px-3 py-2.5 text-[1rem]">
          Quick links
        </p>
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="ui-copy flex items-center gap-2 border-r border-[var(--color-divider)] px-3 py-2.5 text-[var(--color-ink)] transition-colors duration-100 ease-in-out hover:bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] last:border-r-0"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {
              link.icon === "github" ? (
                <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.59c1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
                </svg>
              ) : link.icon === "scholar" ? (
                <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 3 1.5 9l10.5 6 8.5-4.86V17h2V9L12 3Zm0 14.1L5.5 13.4v2.7c0 1.6 3 3.4 6.5 3.4s6.5-1.8 6.5-3.4v-2.7L12 17.1Z" />
                </svg>
              ) : (
                <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 18V6" />
                  <path d="M4 12h16" />
                  <path d="M20 6v12" />
                </svg>
              )
            }
            <span>{link.label}</span>
          </a>
        ))}
      </nav>

      <ResearchBentoGrid id="research-list">
        {orderedItems.map(({ entry, layout }) =>
          entry.collection === "papers" ? (
            <ResearchCard
              collection="papers"
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              tags={entry.data.tags}
              authors={entry.data.authors}
              venue={entry.data.venue}
              year={entry.data.year}
              status={entry.data.status}
              doi={entry.data.doi}
              arxiv={entry.data.arxiv}
              preview={entry.data.preview}
              layout={layout}
              anchorId={entry.id === firstPaperId ? "publications" : undefined}
            />
          ) : (
            <ResearchCard
              collection="repos"
              slug={entry.id}
              title={entry.data.title}
              description={entry.data.description}
              url={entry.data.url}
              topics={entry.data.topics}
              stack={entry.data.stack}
              language={entry.data.language}
              preview={entry.data.preview}
              layout={layout}
              anchorId={entry.id === firstRepoId ? "code" : undefined}
            />
          )
        )}
      </ResearchBentoGrid>
    </div>
  </section>
</BaseLayout>
