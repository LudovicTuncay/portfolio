---
import { getCollection } from "astro:content";
import {
    AudioLines,
    BrainCircuit,
    ChartNoAxesColumnIncreasing,
    CodeXml,
    DatabaseZap,
} from "@lucide/astro";
import ResearchBentoGrid from "../components/research/ResearchBentoGrid.astro";
import ResearchCard from "../components/research/ResearchCard.astro";
import { researchGrid } from "../data/research-grid";
import BaseLayout from "../layouts/BaseLayout.astro";

const [papers, repos] = await Promise.all([
    getCollection("papers"),
    getCollection("repos"),
]);

const papersById = new Map(papers.map((entry) => [entry.id, entry]));
const reposById = new Map(repos.map((entry) => [entry.id, entry]));

const orderedItems = researchGrid
    .slice()
    .sort((left, right) => left.order - right.order)
    .map((layout) => {
        const entry =
            layout.collection === "papers"
                ? papersById.get(layout.slug)
                : reposById.get(layout.slug);

        if (!entry) {
            throw new Error(
                `Missing research entry for ${layout.collection}/${layout.slug}`,
            );
        }

        return { entry, layout };
    });

const firstPaperId = orderedItems.find(
    ({ entry }) => entry.collection === "papers",
)?.entry.id;
const firstRepoId = orderedItems.find(
    ({ entry }) => entry.collection === "repos",
)?.entry.id;

const researchInterests = [
    { label: "SSL", Icon: BrainCircuit },
    { label: "Audio embeddings", Icon: AudioLines },
    { label: "Evaluation and benchmarking", Icon: ChartNoAxesColumnIncreasing },
    { label: "Dataset curation/correction", Icon: DatabaseZap },
    { label: "Open-source systems and tools", Icon: CodeXml },
];

const quickLinks = [
    {
        href: "https://scholar.google.com/citations?user=VnyL-2AAAAAJ",
        label: "Google Scholar",
        external: true,
        icon: "/google-scholar.svg",
    },
    {
        href: "https://github.com/LudovicTuncay",
        label: "GitHub",
        external: true,
        icon: "github",
    },
    {
        href: "https://hal.science/search/index/q/*/authFullName_s/Ludovic+Tuncay",
        label: "HAL",
        external: true,
        icon: "/HAL-icon.svg",
    },
];
---

<BaseLayout
    title="LKT | Research & Code"
    currentPath="/research-code"
    description="Research and code page for Ludovic K. TUNCAY."
>
    <section class="page-container pt-12 md:pt-16">
        <div class="space-y-8 md:space-y-10">
            <div
                class="grid gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.75fr)] md:items-start"
            >
                <div class="space-y-6">
                    <h1 class="display-title">
                        <span class="accent-glow">Research</span>
                        <span> &amp; </span>
                        <span class="accent-glow-secondary">Code</span>
                    </h1>
                    <p class="body-copy max-w-[42rem]">
                        Papers, open-source systems, and tools. Most of my work
                        explores self-supervised learning for audio
                        representation and its applications.
                    </p>
                </div>

                <aside
                    class="research-interest-stack border-t border-[var(--color-divider)] pt-6 md:border-l md:border-t-0 md:pl-10 md:pt-0"
                >
                    <h2 class="research-label text-[var(--color-ink)]">
                        Research interests
                    </h2>
                    <ul role="list" class="space-y-2">
                        {
                            researchInterests.map(({ label, Icon }) => (
                                <li class="flex items-center gap-3">
                                    <Icon
                                        class="h-5 w-5 shrink-0 text-[var(--color-ink)]"
                                        aria-hidden="true"
                                        strokeWidth={3}
                                    />
                                    <span class="body-copy text-[clamp(0.95rem,1.3vw,1rem)]">
                                        {label}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </aside>
            </div>

            <nav
                aria-label="Quick links"
                class="flex max-w-full flex-wrap items-center gap-3"
            >
                <p class="entry-title mr-1 text-[1rem]">Quick links:</p>
                {
                    quickLinks.map((link) => (
                        <a
                            href={link.href}
                            class="button-shell button-muted !gap-2 !px-3 !py-2"
                            target={link.external ? "_blank" : undefined}
                            rel={link.external ? "noreferrer" : undefined}
                        >
                            {link.icon === "github" ? (
                                <>
                                    <img
                                        src="/GitHub_light.svg"
                                        alt=""
                                        class="github-mark github-mark-light"
                                        loading="lazy"
                                    />
                                    <img
                                        src="/GitHub_dark.svg"
                                        alt=""
                                        class="github-mark github-mark-dark"
                                        loading="lazy"
                                    />
                                </>
                            ) : (
                                <img
                                    src={link.icon}
                                    alt=""
                                    class="h-4 w-4 shrink-0"
                                    loading="lazy"
                                />
                            )}
                            <span>{link.label}</span>
                        </a>
                    ))
                }
            </nav>

            <ResearchBentoGrid id="research-list">
                {
                    orderedItems.map(({ entry, layout }) =>
                        entry.collection === "papers" ? (
                            <ResearchCard
                                collection="papers"
                                slug={entry.id}
                                title={entry.data.title}
                                summary={entry.data.summary}
                                tags={entry.data.tags}
                                authors={entry.data.authors}
                                venue={entry.data.venue}
                                year={entry.data.year}
                                status={entry.data.status}
                                doi={entry.data.doi}
                                arxiv={entry.data.arxiv}
                                preview={entry.data.preview}
                                layout={layout}
                                anchorId={
                                    entry.id === firstPaperId
                                        ? "publications"
                                        : undefined
                                }
                            />
                        ) : (
                            <ResearchCard
                                collection="repos"
                                slug={entry.id}
                                title={entry.data.title}
                                description={entry.data.description}
                                url={entry.data.url}
                                topics={entry.data.topics}
                                stack={entry.data.stack}
                                language={entry.data.language}
                                preview={entry.data.preview}
                                layout={layout}
                                anchorId={
                                    entry.id === firstRepoId
                                        ? "code"
                                        : undefined
                                }
                            />
                        ),
                    )
                }
            </ResearchBentoGrid>
        </div>
    </section>
</BaseLayout>
