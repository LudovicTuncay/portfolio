---
import ButtonLink from "../components/ButtonLink.astro";
import HeroPortrait from "../components/HeroPortrait.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  aboutParagraphs,
  education,
  experiences,
  introActions,
  languages,
  photographyParagraph,
  publications,
  researchParagraph
} from "../data/home";
---

<BaseLayout
  title="LKT | Home"
  currentPath="/"
  description="Academic portfolio for Ludovic K. TUNCAY covering machine learning research, publications, experience, and photography."
>
  <section class="page-container pt-12 md:pt-16">
    <div class="space-y-10 md:space-y-12">
      <div class="max-w-full space-y-1">
        <h1 class="display-title">Hello 👋🏻</h1>
        <p class="display-title md:whitespace-nowrap">Welcome to my website !</p>
      </div>

      <div class="grid items-center gap-10 md:grid-cols-[minmax(0,560px)_minmax(0,1fr)] md:gap-12">
        <HeroPortrait />

        <div class="space-y-6">
          <p class="body-copy max-w-[24rem]">
            I am Ludovic K. TUNCAY, a PhD student working
            on <span class="body-emphasis">machine learning</span> applied to audio in all its
            forms. This website serves as my personal portfolio
            where you can see the research I have done,
            alongside one of my favorite hobby: <span class="body-emphasis">photography</span>.
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            {introActions.map((action) => (
              <ButtonLink href={action.href} label={action.label} muted={action.muted} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="page-container pt-[var(--section-gap-xl)]">
    <div class="space-y-8">
      <SectionHeading title="About me" />
      <div class="max-w-[62rem] space-y-6">
        {aboutParagraphs.map((paragraph) => (
          <p class="body-copy">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="page-container pt-[var(--section-gap-lg)]">
    <div class="space-y-8">
      <h3 class="section-title">Thesis research interests</h3>
      <p class="body-copy max-w-[62rem]">{researchParagraph}</p>
      <div class="pt-4">
        <ButtonLink href="/research-code" label="Learn more" />
      </div>
    </div>
  </section>

  <section class="page-container pt-[var(--section-gap-md)]">
    <div class="space-y-8">
      <h3 class="section-title">Why photography ?</h3>
      <p class="body-copy max-w-[62rem]">{photographyParagraph}</p>
      <div class="pt-4">
        <ButtonLink href="/photography" label="Take a look" />
      </div>
    </div>
  </section>

  <section id="resume" class="page-container pt-[var(--section-gap-xl)]">
    <div class="space-y-10">
      <SectionHeading title="Resume" />

      <div class="space-y-6">
        <h3 class="section-title">Research & Publications</h3>
        <div class="divide-y divide-[var(--color-divider)]">
          {publications.map((entry) => (
            <ResumeEntry {...entry} />
          ))}
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="section-title">Experience</h3>
        <div class="divide-y divide-[var(--color-divider)]">
          {experiences.map((entry) => (
            <ResumeEntry {...entry} />
          ))}
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="section-title">Education</h3>
        <div class="divide-y divide-[var(--color-divider)]">
          {education.map((entry) => (
            <ResumeEntry {...entry} />
          ))}
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="section-title">Languages</h3>
        <div class="pt-5">
          <ul role="list" class="grid gap-4 md:grid-cols-4 md:gap-10">
            {languages.map((lang) => (
              <li class="space-y-1">
                <p class="entry-title">{lang.name}</p>
                <p class="body-copy">{lang.level}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
