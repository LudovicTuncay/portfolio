{
	"compatibility_date": "2026-03-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Add this once the originals bucket exists and private R2 downloads are implemented:
	// "r2_buckets": [
	// 	{ "binding": "ALBUM_ORIGINALS", "bucket_name": "your-r2-originals-bucket" }
	// ],
	"observability": {
		"enabled": true
	}
}
