# Cloudinary serves optimized album images.
# Cloud name is public and safe to expose in client-rendered image URLs.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional Cloudinary folder prefix for album assets, for example:
# portfolio/albums
PUBLIC_CLOUDINARY_ALBUM_FOLDER=

# R2 stores original files for downloads.
# Use a public R2/custom-domain base URL here if originals are public.
# If originals should stay private, leave this empty and add a server download route
# backed by an R2 binding when album downloads are implemented.
PUBLIC_R2_ORIGINALS_BASE_URL=

# Future upload/sync tooling may need these server-side values.
# Do not expose these with a PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ORIGINALS_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
